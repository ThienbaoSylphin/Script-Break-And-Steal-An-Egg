-- Biểu tượng Logo Chữ S độc quyền SylPhin (Thay thế Logo M cũ)
local Draw = {}
function Draw.SylPhinEmblem(parent, size)
    local emblem = Instance.new("Frame")
    emblem.Name = "SylPhinEmblem"
    emblem.Size = UDim2.fromOffset(size, size)
    emblem.BackgroundColor3 = Themes["SylPhin Dark"].Accent
    emblem.BorderSizePixel = 0
    emblem.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = emblem

    local stroke = Instance.new("UIStroke")
    stroke.Color = Themes["SylPhin Dark"].Glow
    stroke.Thickness = 1.5
    stroke.Parent = emblem

    local letter = Instance.new("TextLabel")
    letter.Text = "S"
    letter.Font = Enum.Font.LuckiestGuy
    letter.TextSize = math.floor(size * 0.6)
    letter.TextColor3 = rgb("FFFFFF")
    letter.Size = UDim2.fromScale(1, 1)
    letter.BackgroundTransparency = 1
    letter.Parent = emblem

    return emblem
end

