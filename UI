                BtnCorner.Parent = Btn

                Btn.MouseButton1Click:Connect(function()
                    Tween(Btn, 0.1, { BackgroundColor3 = Library.Theme.Accent })
                    task.wait(0.1)
                    Tween(Btn, 0.2, { BackgroundColor3 = Library.Theme.Element })
                    pcall(Callback)
                end)

                return Btn
            end

            -- -----------------------------------------------
            -- ADD LABEL
            -- -----------------------------------------------
            function Groupbox:AddLabel(Text)
                local Label = Instance.new("TextLabel")
                Label.Size = UDim2.new(1, 0, 0, 20)
                Label.BackgroundTransparency = 1
                Label.Font = Enum.Font.Gotham
                Label.Text = Text or ""
                Label.TextColor3 = Library.Theme.SubText
                Label.TextSize = 12
                Label.TextXAlignment = Enum.TextXAlignment.Left
                Label.TextWrapped = true
                Label.Parent = ItemHolder

                return {
                    SetText = function(_, newText) Label.Text = newText end
                }
            end

            return Groupbox
        end

        function Tab:AddLeftGroupbox(title)
            return CreateGroupbox(LeftColumn, title)
        end

        function Tab:AddRightGroupbox(title)
            return CreateGroupbox(RightColumn, title)
        end

        table.insert(Window.Tabs, Tab)
        return Tab
    end

    Library.Window = Window
    return Window
end

return Library
